# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://botsware:password@localhost:5432/botsware

# ── WhatsApp (WAHA) ───────────────────────────────────────────────────────────
# The exact name of the WhatsApp group to listen to (optional if using GROUP_ID)
GROUP_NAME=Botsqware

# The WhatsApp chat ID of the group — preferred over GROUP_NAME
# Get it with: make waha-get-chats  (looks like 120363XXXXXXXXXX@g.us)
GROUP_ID=

# WAHA session name (default is fine unless you run multiple sessions)
WAHA_SESSION=default

# WAHA base URL — use localhost when running FastAPI locally
#                 use http://waha:3000 when running inside Docker
WAHA_BASE_URL=http://localhost:3000

# ── LLM (Docker Model Runner) ─────────────────────────────────────────────────
# Model name as registered in Docker Model Runner
LLM_MODEL=ai/qwen2.5:7B-Q4_K_M

# DMR endpoint — use host.docker.internal when FastAPI runs in Docker
#                use localhost when running FastAPI locally
LLM_BASE_URL=http://localhost:12434

# No real key needed for local Docker Model Runner
LLM_API_KEY=not-needed

# ── Band profile ──────────────────────────────────────────────────────────────
BAND_PROFILE_PATH=band_profile.yaml