{
  "name": "botsqware-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.0",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:full": "docker compose up -d postgres waha && sleep 3 && bun --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "services:up": "docker compose up -d waha postgres",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "format": "biome format --write .",
    "lint": "biome lint . --diagnostic-level=error",
    "lint:fix": "biome lint --write ."
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@boundaryml/baml": "^0.220.0",
    "@mastra/core": "^1.14.0",
    "ai": "^6.0.116",
    "consola": "^3.4.2",
    "hono": "^3.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "bun-types": "^1.0.0",
    "eslint": "^10.0.3",
    "eslint-config-biome": "^2.1.3",
    "eslint-plugin-perfectionist": "^5.7.0",
    "mastra": "^1.3.13",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
